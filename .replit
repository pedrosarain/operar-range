run = "PYTHONPATH=src python main.py"
modules = ["python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["arrow-cpp", "libiconv", "pkg-config"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run sample"

[[workflows.workflow]]
name = "Run sample"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PYTHONPATH=src python main.py"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8501

[[ports]]
localPort = 8502
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "exec streamlit run app/main.py --server.address 0.0.0.0 --server.port=${PORT:-8501} --server.headless=true"]
